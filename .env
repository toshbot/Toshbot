# --- General ---
ENVIRONMENT=development          # development | production (production REQUIRES API_KEY)
LOG_LEVEL=INFO
API_KEY=change-me                # clients send this in the X-API-Key header
CORS_ORIGINS=http://localhost:3000

# --- Storage ---
# firestore = real persistence (default). memory = NOT persistent, local experiments only.
STORAGE_BACKEND=firestore
FIREBASE_PROJECT_ID=
# Path to your Firebase service-account JSON (download from Firebase console). NEVER commit it.
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_COLLECTION_PREFIX=
# For the local emulator instead of a real project, set (shell env, not needed here):
#   FIRESTORE_EMULATOR_HOST=localhost:8080

# --- PumpPortal feed ---
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
LISTENER_ENABLED=true
RECONNECT_BASE_SECONDS=1
RECONNECT_MAX_SECONDS=60
STABLE_CONNECTION_SECONDS=30
FEED_STALE_AFTER_SECONDS=120
QUEUE_MAXSIZE=1000
PROCESSOR_MAX_ATTEMPTS=3
